{
  "name": "novel-translate-editor",
  "displayName": "小說翻譯編輯器",
  "description": "輔助小說翻譯工作的 VSCode 套件：作品管理、原文／譯文比對、詞彙表自動完成、翻譯註解。",
  "version": "0.0.1",
  "publisher": "your-publisher-id",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "novelTranslate",
          "title": "小說翻譯",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "novelTranslate": [
        {
          "id": "novelTranslate.works",
          "name": "作品總管"
        },
        {
          "id": "novelTranslate.glossary",
          "name": "詞彙表"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "novelTranslate.works",
        "contents": "尚未建立任何作品。\n[建立新作品](command:novelTranslate.createWork)\n\n作品管理功能將於後續版本實作（Phase 1）。"
      }
    ],
    "commands": [
      {
        "command": "novelTranslate.createWork",
        "title": "小說翻譯：建立新作品",
        "category": "小說翻譯"
      },
      {
        "command": "novelTranslate.openCompareView",
        "title": "小說翻譯：開啟原文／譯文比對",
        "category": "小說翻譯"
      }
    ],
    "languages": [
      {
        "id": "novel-translation",
        "aliases": [
          "Novel Translation",
          "小說翻譯文字"
        ],
        "extensions": []
      }
    ],
    "configurationDefaults": {
      "[novel-translation]": {
        "editor.wordBasedSuggestions": "off"
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "pretest": "npm run compile && npm run lint",
    "test": "vscode-test",
    "package-vsix": "node -e \"require('fs').mkdirSync('releases',{recursive:true})\" && vsce package -o releases/ --no-rewrite-relative-links"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.23.1",
    "eslint": "^9.9.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.0.0"
  }
}
