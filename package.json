{
  "name": "novel-translate-editor",
  "displayName": "小說翻譯編輯器",
  "description": "輔助小說翻譯工作的 VSCode 套件：作品管理、原文／譯文比對、詞彙表自動完成、翻譯註解。",
  "version": "0.0.1",
  "publisher": "your-publisher-id",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "novelTranslate",
          "title": "小說翻譯",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "novelTranslate": [
        {
          "id": "novelTranslate.works",
          "name": "作品總管"
        },
        {
          "id": "novelTranslate.glossary",
          "name": "詞彙表"
        },
        {
          "id": "novelTranslate.settings",
          "name": "設置"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "novelTranslate.works",
        "contents": "尚未建立任何作品。\n[建立新作品](command:novelTranslate.createWork)"
      },
      {
        "view": "novelTranslate.glossary",
        "contents": "請先到「作品總管」建立作品，再回來這裡新增詞條。"
      }
    ],
    "commands": [
      {
        "command": "novelTranslate.createWork",
        "title": "小說翻譯：建立新作品",
        "category": "小說翻譯",
        "icon": "$(add)"
      },
      {
        "command": "novelTranslate.refreshWorks",
        "title": "小說翻譯：重新整理作品清單",
        "category": "小說翻譯",
        "icon": "$(refresh)"
      },
      {
        "command": "novelTranslate.addChapter",
        "title": "小說翻譯：新增章節",
        "category": "小說翻譯",
        "icon": "$(new-file)"
      },
      {
        "command": "novelTranslate.importChapterFile",
        "title": "小說翻譯：匯入文字檔為章節",
        "category": "小說翻譯"
      },
      {
        "command": "novelTranslate.openCompareView",
        "title": "小說翻譯：開啟原文／譯文比對",
        "category": "小說翻譯"
      },
      {
        "command": "novelTranslate.toggleScrollSync",
        "title": "小說翻譯：切換原文／譯文同步捲動",
        "category": "小說翻譯"
      },
      {
        "command": "novelTranslate.refreshGlossary",
        "title": "小說翻譯：重新整理詞彙表",
        "category": "小說翻譯",
        "icon": "$(refresh)"
      },
      {
        "command": "novelTranslate.addGlossaryEntry",
        "title": "小說翻譯：新增詞條",
        "category": "小說翻譯",
        "icon": "$(new-file)"
      },
      {
        "command": "novelTranslate.editGlossaryEntry",
        "title": "小說翻譯：編輯詞條",
        "category": "小說翻譯"
      },
      {
        "command": "novelTranslate.deleteGlossaryEntry",
        "title": "小說翻譯：刪除詞條",
        "category": "小說翻譯"
      },
      {
        "command": "novelTranslate.toggleAutocompleteMode",
        "title": "小說翻譯：切換詞彙表自動完成模式",
        "category": "小說翻譯"
      },
      {
        "command": "novelTranslate.submitComment",
        "title": "送出",
        "category": "小說翻譯",
        "enablement": "!commentIsEmpty"
      },
      {
        "command": "novelTranslate.toggleCommentResolved",
        "title": "切換已解決／待確認",
        "category": "小說翻譯",
        "icon": "$(check)"
      },
      {
        "command": "novelTranslate.deleteCommentThread",
        "title": "刪除討論串",
        "category": "小說翻譯",
        "icon": "$(trash)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "novelTranslate.createWork",
          "when": "view == novelTranslate.works",
          "group": "navigation"
        },
        {
          "command": "novelTranslate.refreshWorks",
          "when": "view == novelTranslate.works",
          "group": "navigation"
        },
        {
          "command": "novelTranslate.refreshGlossary",
          "when": "view == novelTranslate.glossary",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "novelTranslate.addChapter",
          "when": "view == novelTranslate.works && viewItem == novelTranslateWork",
          "group": "inline"
        },
        {
          "command": "novelTranslate.importChapterFile",
          "when": "view == novelTranslate.works && viewItem == novelTranslateWork"
        },
        {
          "command": "novelTranslate.openCompareView",
          "when": "view == novelTranslate.works && viewItem == novelTranslateChapter"
        },
        {
          "command": "novelTranslate.addGlossaryEntry",
          "when": "view == novelTranslate.glossary && viewItem == novelTranslateGlossaryWork",
          "group": "inline"
        },
        {
          "command": "novelTranslate.editGlossaryEntry",
          "when": "view == novelTranslate.glossary && viewItem == novelTranslateGlossaryEntry"
        },
        {
          "command": "novelTranslate.deleteGlossaryEntry",
          "when": "view == novelTranslate.glossary && viewItem == novelTranslateGlossaryEntry"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "novelTranslate.submitComment",
          "group": "inline",
          "when": "commentController == novelTranslate.notes"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "novelTranslate.toggleCommentResolved",
          "group": "navigation",
          "when": "commentController == novelTranslate.notes"
        },
        {
          "command": "novelTranslate.deleteCommentThread",
          "group": "navigation",
          "when": "commentController == novelTranslate.notes"
        }
      ]
    },
    "languages": [
      {
        "id": "novel-translation",
        "aliases": [
          "Novel Translation",
          "小說翻譯文字"
        ],
        "extensions": []
      }
    ],
    "configurationDefaults": {
      "[novel-translation]": {
        "editor.wordBasedSuggestions": "off"
      }
    },
    "configuration": {
      "title": "小說翻譯",
      "properties": {
        "novelTranslate.compareScrollSync.enabled": {
          "type": "boolean",
          "default": true,
          "description": "開啟原文／譯文比對畫面時，是否同步捲動兩側編輯器。"
        },
        "novelTranslate.glossaryAutocomplete.enabled": {
          "type": "boolean",
          "default": true,
          "description": "開啟原文／譯文比對畫面時，是否自動套用詞彙表自動完成語言模式（關閉後維持一般自動完成）。"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "pretest": "npm run compile && npm run lint",
    "test": "vscode-test",
    "package-vsix": "node -e \"require('fs').mkdirSync('releases',{recursive:true})\" && vsce package -o releases/ --no-rewrite-relative-links"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.23.1",
    "eslint": "^9.9.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.0.0"
  }
}
