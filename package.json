{
  "name": "novel-translate-editor",
  "displayName": "小說翻譯編輯器",
  "description": "輔助小說翻譯工作的 VSCode 套件：作品管理、原文／譯文比對、詞彙表自動完成、翻譯註解、EPUB 匯入／匯出。",
  "version": "0.1.0",
  "publisher": "a7code",
  "private": true,
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/A7Code/translate-novel-editor.git"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "novelTranslate",
          "title": "小說翻譯",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "novelTranslate": [
        {
          "id": "novelTranslate.works",
          "name": "作品總管"
        },
        {
          "id": "novelTranslate.glossary",
          "name": "詞彙表"
        },
        {
          "id": "novelTranslate.settings",
          "name": "設置"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "novelTranslate.works",
        "contents": "尚未建立任何作品。\n[建立新作品](command:novelTranslate.createWork)"
      },
      {
        "view": "novelTranslate.glossary",
        "contents": "請先到「作品總管」建立作品，再回來這裡新增詞條。"
      }
    ],
    "commands": [
      {
        "command": "novelTranslate.createWork",
        "title": "小說翻譯：建立新作品",
        "category": "小說翻譯",
        "icon": "$(add)"
      },
      {
        "command": "novelTranslate.editWork",
        "title": "小說翻譯：編輯作品",
        "category": "小說翻譯",
        "icon": "$(edit)"
      },
      {
        "command": "novelTranslate.openWorkManager",
        "title": "小說翻譯：開啟作品管理",
        "category": "小說翻譯",
        "icon": "$(library)"
      },
      {
        "command": "novelTranslate.refreshWorks",
        "title": "小說翻譯：重新整理作品清單",
        "category": "小說翻譯",
        "icon": "$(refresh)"
      },
      {
        "command": "novelTranslate.addChapter",
        "title": "小說翻譯：新增章節",
        "category": "小說翻譯",
        "icon": "$(new-file)"
      },
      {
        "command": "novelTranslate.renameChapter",
        "title": "小說翻譯：重新命名章節",
        "category": "小說翻譯",
        "icon": "$(edit)"
      },
      {
        "command": "novelTranslate.moveItemUp",
        "title": "上移",
        "category": "小說翻譯",
        "icon": "$(arrow-up)"
      },
      {
        "command": "novelTranslate.moveItemDown",
        "title": "下移",
        "category": "小說翻譯",
        "icon": "$(arrow-down)"
      },
      {
        "command": "novelTranslate.importChapterFile",
        "title": "小說翻譯：匯入文字檔為章節",
        "category": "小說翻譯"
      },
      {
        "command": "novelTranslate.openCompareView",
        "title": "小說翻譯：開啟原文／譯文比對",
        "category": "小說翻譯"
      },
      {
        "command": "novelTranslate.toggleScrollSync",
        "title": "小說翻譯：切換原文／譯文同步捲動",
        "category": "小說翻譯"
      },
      {
        "command": "novelTranslate.toggleCompareLayout",
        "title": "小說翻譯：切換比對畫面版面（翻譯在左／原文在左）",
        "category": "小說翻譯"
      },
      {
        "command": "novelTranslate.refreshGlossary",
        "title": "小說翻譯：重新整理詞彙表",
        "category": "小說翻譯",
        "icon": "$(refresh)"
      },
      {
        "command": "novelTranslate.addGlossaryEntry",
        "title": "小說翻譯：新增詞條",
        "category": "小說翻譯",
        "icon": "$(new-file)"
      },
      {
        "command": "novelTranslate.addGlossaryCategory",
        "title": "小說翻譯：新增詞彙分類",
        "category": "小說翻譯",
        "icon": "$(new-folder)"
      },
      {
        "command": "novelTranslate.addGlossaryEntryToCategory",
        "title": "小說翻譯：在此分類新增詞條",
        "category": "小說翻譯",
        "icon": "$(new-file)"
      },
      {
        "command": "novelTranslate.editGlossaryEntry",
        "title": "小說翻譯：編輯詞條",
        "category": "小說翻譯"
      },
      {
        "command": "novelTranslate.deleteGlossaryEntry",
        "title": "小說翻譯：刪除詞條",
        "category": "小說翻譯"
      },
      {
        "command": "novelTranslate.openGlossaryManager",
        "title": "小說翻譯：開啟詞彙管理",
        "category": "小說翻譯",
        "icon": "$(link-external)"
      },
      {
        "command": "novelTranslate.toggleAutocompleteMode",
        "title": "小說翻譯：切換詞彙表自動完成模式",
        "category": "小說翻譯"
      },
      {
        "command": "novelTranslate.suggestPunctuationFromOriginal",
        "title": "小說翻譯：推薦原文同一行的標點符號",
        "category": "小說翻譯"
      },
      {
        "command": "novelTranslate.configurePunctuationSuggestKeybinding",
        "title": "小說翻譯：設定「推薦原文標點符號」的快捷鍵",
        "category": "小說翻譯",
        "icon": "$(keyboard)"
      },
      {
        "command": "novelTranslate.submitComment",
        "title": "送出",
        "category": "小說翻譯",
        "enablement": "!commentIsEmpty"
      },
      {
        "command": "novelTranslate.toggleCommentResolved",
        "title": "切換已解決／待確認",
        "category": "小說翻譯",
        "icon": "$(check)"
      },
      {
        "command": "novelTranslate.deleteCommentThread",
        "title": "刪除討論串",
        "category": "小說翻譯",
        "icon": "$(trash)"
      },
      {
        "command": "novelTranslate.importEpub",
        "title": "小說翻譯：匯入 EPUB",
        "category": "小說翻譯",
        "icon": "$(cloud-download)"
      },
      {
        "command": "novelTranslate.exportEpub",
        "title": "小說翻譯：匯出為 EPUB",
        "category": "小說翻譯",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "novelTranslate.upgradeEpubChapters",
        "title": "小說翻譯：升級 EPUB 章節",
        "category": "小說翻譯"
      },
      {
        "command": "novelTranslate.restoreProjectBackup",
        "title": "小說翻譯：從備份還原專案",
        "category": "小說翻譯"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "novelTranslate.openWorkManager",
          "when": "view == novelTranslate.works",
          "group": "navigation"
        },
        {
          "command": "novelTranslate.createWork",
          "when": "view == novelTranslate.works",
          "group": "navigation"
        },
        {
          "command": "novelTranslate.refreshWorks",
          "when": "view == novelTranslate.works",
          "group": "navigation"
        },
        {
          "command": "novelTranslate.createWork",
          "when": "view == novelTranslate.glossary",
          "group": "navigation"
        },
        {
          "command": "novelTranslate.refreshGlossary",
          "when": "view == novelTranslate.glossary",
          "group": "navigation"
        },
        {
          "command": "novelTranslate.openGlossaryManager",
          "when": "view == novelTranslate.glossary",
          "group": "navigation"
        },
        {
          "command": "novelTranslate.importEpub",
          "when": "view == novelTranslate.works",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "novelTranslate.renameChapter",
          "when": "false"
        },
        {
          "command": "novelTranslate.moveItemUp",
          "when": "false"
        },
        {
          "command": "novelTranslate.moveItemDown",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "novelTranslate.addChapter",
          "when": "view == novelTranslate.works && viewItem =~ /^novelTranslateWork/",
          "group": "inline"
        },
        {
          "command": "novelTranslate.editWork",
          "when": "view == novelTranslate.works && viewItem =~ /^novelTranslateWork/",
          "group": "1_modification"
        },
        {
          "command": "novelTranslate.renameChapter",
          "when": "view == novelTranslate.works && viewItem == novelTranslateChapter",
          "group": "1_modification"
        },
        {
          "command": "novelTranslate.moveItemUp",
          "when": "view == novelTranslate.works && viewItem =~ /^novelTranslate(Work|Chapter)/",
          "group": "2_order@1"
        },
        {
          "command": "novelTranslate.moveItemDown",
          "when": "view == novelTranslate.works && viewItem =~ /^novelTranslate(Work|Chapter)/",
          "group": "2_order@2"
        },
        {
          "command": "novelTranslate.importChapterFile",
          "when": "view == novelTranslate.works && viewItem =~ /^novelTranslateWork/"
        },
        {
          "command": "novelTranslate.exportEpub",
          "when": "view == novelTranslate.works && viewItem == novelTranslateWork-epub"
        },
        {
          "command": "novelTranslate.upgradeEpubChapters",
          "when": "view == novelTranslate.works && viewItem == novelTranslateWork-epub"
        },
        {
          "command": "novelTranslate.openCompareView",
          "when": "view == novelTranslate.works && viewItem == novelTranslateChapter"
        },
        {
          "command": "novelTranslate.addGlossaryEntry",
          "when": "view == novelTranslate.glossary && viewItem == novelTranslateGlossaryWork",
          "group": "inline@1"
        },
        {
          "command": "novelTranslate.addGlossaryCategory",
          "when": "view == novelTranslate.glossary && viewItem == novelTranslateGlossaryWork",
          "group": "inline@2"
        },
        {
          "command": "novelTranslate.editWork",
          "when": "view == novelTranslate.glossary && viewItem == novelTranslateGlossaryWork",
          "group": "inline@3"
        },
        {
          "command": "novelTranslate.addGlossaryEntryToCategory",
          "when": "view == novelTranslate.glossary && viewItem == novelTranslateGlossaryCategory",
          "group": "inline"
        },
        {
          "command": "novelTranslate.editGlossaryEntry",
          "when": "view == novelTranslate.glossary && viewItem == novelTranslateGlossaryEntry"
        },
        {
          "command": "novelTranslate.deleteGlossaryEntry",
          "when": "view == novelTranslate.glossary && viewItem == novelTranslateGlossaryEntry"
        },
        {
          "command": "novelTranslate.configurePunctuationSuggestKeybinding",
          "when": "view == novelTranslate.settings && viewItem == settingsPunctuationKeybinding",
          "group": "inline"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "novelTranslate.submitComment",
          "group": "inline",
          "when": "commentController == novelTranslate.notes"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "novelTranslate.toggleCommentResolved",
          "group": "navigation",
          "when": "commentController == novelTranslate.notes"
        },
        {
          "command": "novelTranslate.deleteCommentThread",
          "group": "navigation",
          "when": "commentController == novelTranslate.notes"
        }
      ]
    },
    "keybindings": [
      {
        "command": "novelTranslate.suggestPunctuationFromOriginal",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p",
        "when": "editorTextFocus && resourceLangId == novel-translation"
      }
    ],
    "languages": [
      {
        "id": "novel-translation",
        "aliases": [
          "Novel Translation",
          "小說翻譯文字"
        ],
        "extensions": []
      }
    ],
    "configurationDefaults": {
      "[novel-translation]": {
        "editor.wordBasedSuggestions": "off"
      }
    },
    "configuration": {
      "title": "小說翻譯",
      "properties": {
        "novelTranslate.compareScrollSync.enabled": {
          "type": "boolean",
          "default": true,
          "description": "開啟原文／譯文比對畫面時，是否同步捲動兩側編輯器。"
        },
        "novelTranslate.compareCursorSync.enabled": {
          "type": "boolean",
          "default": true,
          "description": "開啟原文／譯文比對畫面時，是否把焦點編輯器的游標行同步到另一側編輯器。"
        },
        "novelTranslate.glossaryAutocomplete.enabled": {
          "type": "boolean",
          "default": true,
          "description": "開啟原文／譯文比對畫面時，是否自動套用詞彙表自動完成語言模式（關閉後維持一般自動完成）。"
        },
        "novelTranslate.compareView.translationOnLeft": {
          "type": "boolean",
          "default": true,
          "description": "開啟原文／譯文比對畫面時，翻譯稿是否顯示在左側（取消勾選則改為原文在左、翻譯在右）。"
        },
        "novelTranslate.glossaryAutocomplete.matchMode": {
          "type": "string",
          "enum": ["exact", "phonetic"],
          "enumDescriptions": [
            "只在輸入文字與詞條完全相同時才推薦補完。",
            "除了完全相同之外，只要游標前一個字跟詞條首字同音（含聲調）也會推薦補完，方便修正注音輸入法選錯的同音錯字（例如打「路」也能推薦「露西亞」）。"
          ],
          "default": "exact",
          "description": "詞彙表自動完成的比對模式。"
        },
        "novelTranslate.punctuationSuggest.enabled": {
          "type": "boolean",
          "default": true,
          "description": "在比對畫面的「譯文」編輯器某一行輸入觸發文字時，是否自動推薦原文同一行出現過的標點符號。"
        },
        "novelTranslate.punctuationSuggest.triggerText": {
          "type": "string",
          "default": "`",
          "minLength": 1,
          "description": "在「譯文」編輯器輸入這段文字時，會跳出原文同一行標點符號的自動完成推薦清單（也可以用下方指定的快捷鍵直接插入並跳出清單）。"
        },
        "novelTranslate.defaultLanguage.source": {
          "type": "string",
          "default": "",
          "description": "新增作品時預先填入的原文語言代碼（例如 ja、en）。留空則不啟用。"
        },
        "novelTranslate.defaultLanguage.target": {
          "type": "string",
          "default": "",
          "description": "新增作品時預先填入的譯文語言代碼（例如 zh-TW）。留空則不啟用。"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "pretest": "npm run check-types && npm run compile && npm run lint",
    "test": "node scripts/run-unit-tests.js",
    "package-vsix": "node -e \"require('fs').mkdirSync('releases',{recursive:true})\" && vsce package -o releases/ --no-rewrite-relative-links"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.23.1",
    "eslint": "^9.9.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.0.0"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "jszip": "^3.10.2",
    "pinyin-pro": "^3.29.5"
  }
}
